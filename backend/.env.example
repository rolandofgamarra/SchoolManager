# Copiar como .env y completar los valores reales

DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=False
ALLOWED_HOSTS=tudominio.com,www.tudominio.com

# Base de datos (reemplazar SQLite por PostgreSQL en producción)
# DATABASE_URL=postgresql://user:password@localhost:5432/schoolmanager

# Redis (requerido para Celery y caché en producción)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# CORS — dominios del frontend (separados por coma)
CORS_ALLOWED_ORIGINS=https://tudominio.com

# Email (SMTP en producción)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu@correo.com
# EMAIL_HOST_PASSWORD=tu-password-de-app
