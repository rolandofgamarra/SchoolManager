{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../frontend/dist"
  },
  "package": {
    "productName": "SchoolManager Pro",
    "version": "1.0.0"
  },
  "app": {
    "identifier": "com.schoolmanager.pro",
    "windows": [
      {
        "title": "SchoolManager Pro",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://releases.schoolmanager.example.com/update/{{target}}/{{current_version}}"
      ],
      "pubkey": "UPDATE_KEY_PLACEHOLDER"
    }
  }
}
